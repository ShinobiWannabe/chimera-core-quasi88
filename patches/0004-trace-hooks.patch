Trace logger hooks for the Chimera core (waterbox/port/trace.c), in both
builds (CHIMERA_CORE): a call before each instruction while tracing is on,
QUASI88's disassembler compiled without its monitor and reading bytes
through a read with no side effects, and that read for the main CPU.

--- a/src/pc88/pc88main.c
+++ b/src/pc88/pc88main.c
@@ -899,6 +899,21 @@
 /*----------------------
  * メモリ・ライト
  *----------------------*/
+#if defined(CHIMERA_CORE)
+/* What main_mem_read would return, with nothing changed: a read through
+ * the ALU leaves the VRAM planes in ALU_buf, and this does not (Chimera's
+ * trace logger reads instruction bytes with it, waterbox/port/trace.c). */
+byte chimera_main_peek(word addr)
+{
+	if (addr >= 0xc000 && vram_access_way == VRAM_ACCESS_ALU) {
+		ALU_memory wk;
+		wk.l = ALU_comp.l ^ (main_vram4)[addr & 0x3fff];
+		return wk.c[0] & wk.c[1] & wk.c[2];
+	}
+	return main_mem_read(addr);
+}
+#endif
+
