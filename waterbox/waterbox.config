{
  "coreName": "QUASI88",
  "systemId": "PC88",
  "systemNames": {
    "PC88": "NEC PC-8801"
  },
  "author": "Showzoh Fukunaga (QUASI88), bubio (the SDL2 port); Chimera port by ShinobiWannabe and contributors",
  "url": "https://github.com/ShinobiWannabe/chimera-core-quasi88",
  "romFile": "rom",
  "deterministic": true,
  "runsOn": [
    "windows-x86_64",
    "linux-x86_64",
    "macos-x86_64"
  ],
  "memoryLayoutMiB": [
    64,
    16,
    16,
    16,
    128
  ],
  "video": {
    "_comment": "QUASI88 draws the 640x400 screen; 200-line modes are drawn line doubled. One frame is one VSYNC, at QUASI88's 55.4 Hz.",
    "width": 640,
    "height": 400,
    "virtualWidth": 640,
    "virtualHeight": 400,
    "vsyncNumerator": 277,
    "vsyncDenominator": 5,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "_comment": "44320 Hz is exactly 800 samples a frame at 55.4 frames a second.",
    "samplesPerFrame": 800,
    "channels": 2,
    "rate": 44320,
    "get": "GetAudio"
  },
  "input": {
    "name": "PC-88 Controller",
    "_comment": "Index order is the wire format (waterbox/q88-input.h, written by tools/gen-config.py): the keyboard row by row, the cursor keys, the number pad, then the joystick, the mouse buttons, the drives and Reset. Wider than 64, so everything rides the SetButton channel.",
