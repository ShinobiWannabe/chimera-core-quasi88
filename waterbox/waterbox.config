    "d88",
    "88d",
    "t88",
    "cmt"
  ],
  "settings": [
    {
      "name": "romFiles",
      "type": "enum",
      "default": "PC88.ROM",
      "options": [
        "PC88.ROM",
        "Separate files"
      ],
      "sync": true,
      "display": "setting.rom_files",
      "description": "setting.rom_files.about"
    },
    {
      "name": "basicMode",
      "type": "enum",
      "default": "V2",
      "options": [
        "V2",
        "V1H",
        "V1S",
        "N"
      ],
      "sync": true,
      "display": "setting.basic_mode",
      "description": "setting.basic_mode.about"
    },
    {
      "name": "cpuClock",
      "type": "enum",
      "default": "4MHz",
      "options": [
        "4MHz",
        "8MHz"
      ],
      "sync": true,
      "display": "setting.cpu_clock",
      "description": "setting.cpu_clock.about"
    },
    {
      "name": "soundBoard",
      "type": "enum",
      "default": "Sound Board I",
      "options": [
        "Sound Board I",
        "Sound Board II"
      ],
      "sync": true,
      "display": "setting.sound_board",
      "description": "setting.sound_board.about"
    },
    {
      "name": "soundGenerator",
      "type": "enum",
      "default": "MAME",
      "options": [
        "MAME",
        "fmgen"
      ],
      "sync": true,
      "display": "setting.sound_generator",
      "description": "setting.sound_generator.about"
    },
    {
      "name": "cpuTiming",
      "type": "enum",
      "default": "0",
      "options": [
        "0",
        "1",
        "2"
      ],
      "sync": true,
      "display": "setting.cpu_timing",
      "description": "setting.cpu_timing.about"
    },
    {
      "name": "fdcWait",
      "type": "bool",
      "default": true,
      "sync": true,
      "display": "setting.fdc_wait",
      "description": "setting.fdc_wait.about"
    },
    {
      "name": "memoryWait",
      "type": "bool",
      "default": false,
      "sync": true,
      "display": "setting.memory_wait",
      "description": "setting.memory_wait.about"
    },
    {
      "name": "monitor",
      "type": "enum",
      "default": "24kHz",
      "options": [
        "24kHz",
        "15kHz"
      ],
      "sync": true,
      "display": "setting.monitor",
      "description": "setting.monitor.about"
    },
    {
      "name": "port",
      "type": "enum",
      "default": "Joystick",
      "options": [
        "Joystick",
        "Mouse",
        "None"
      ],
      "sync": true,
      "display": "setting.port",
      "description": "setting.port.about"
    },
    {
      "name": "dipSwitches",
      "type": "string",
      "default": "391A",
      "sync": true,
      "display": "setting.dip_switches",
      "description": "setting.dip_switches.about"
    },
    {
      "name": "bootFrom",
      "type": "enum",
      "default": "Disk",
      "options": [
        "Disk",
        "ROM"
      ],
      "sync": true,
      "display": "setting.boot_from",
      "description": "setting.boot_from.about"
    },
    {
      "name": "extraRam",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 16,
      "sync": true,
      "display": "setting.extra_ram",
      "description": "setting.extra_ram.about"
    },
    {
      "name": "kanjiLevel2",
      "type": "bool",
      "default": true,
      "sync": true,
      "display": "setting.kanji_level2",
      "description": "setting.kanji_level2.about"
    },
    {
      "name": "dictionaryRom",
      "type": "bool",
      "default": false,
      "sync": true,
      "display": "setting.dictionary_rom",
      "description": "setting.dictionary_rom.about"
    },
    {
      "name": "startTime",
      "type": "datetime",
      "default": 567993600,
      "sync": true,
      "display": "setting.start_time",
      "description": "setting.start_time.about"
    },
    {
      "name": "rhythmSamples",
      "type": "bool",
      "default": false,
      "sync": true,
      "display": "setting.rhythm_samples",
      "description": "setting.rhythm_samples.about"
    },
    {
      "name": "volumeFM",
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 100,
      "display": "setting.volume_f_m",
      "description": "setting.volume_f_m.about"
    },
    {
      "name": "volumeSSG",
      "type": "int",
      "default": 20,
      "min": 0,
      "max": 100,
      "display": "setting.volume_s_s_g",
      "description": "setting.volume_s_s_g.about"
    },
    {
      "name": "volumeBeep",
      "type": "int",
      "default": 60,
      "min": 0,
      "max": 100,
      "display": "setting.volume_beep",
      "description": "setting.volume_beep.about"
    },
    {
      "name": "volumeRhythm",
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 200,
      "display": "setting.volume_rhythm",
      "description": "setting.volume_rhythm.about"
    },
    {
      "name": "volumeADPCM",
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 200,
      "display": "setting.volume_a_d_p_c_m",
      "description": "setting.volume_a_d_p_c_m.about"
    },
    {
      "name": "volumeFmgen",
      "type": "int",
      "default": 100,
      "min": 0,
      "max": 100,
      "display": "setting.volume_fmgen",
      "description": "setting.volume_fmgen.about"
    }
  ],
  "firmware": [
    {
      "id": "pc88.rom",
